<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free Unity assemblies (Core, Save, Services) against .NET Standard 2.1, the same API surface Unity uses. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Pure</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Game/Core/**/*.cs" />
    <Compile Include="../../Assets/_Game/Save/**/*.cs" />
    <Compile Include="../../Assets/_Game/Services/**/*.cs" />
    <Compile Include="../../Assets/_Game/ViewModels/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
